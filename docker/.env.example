APP_NAME=CLINiQ
APP_ENV=production
APP_URL=https://plpuhs.dpdns.org/public
MAIL_FROM=plphealthservices@plpuhs.qd.je
MAIL_FROM_NAME=University Health Services
MAIL_REPLY_TO=plpuhs2026@gmail.com
# On the production host, replace this with the permanent HTTPS patient hostname.
PATIENT_PORTAL_URL=https://plpuhs.dpdns.org
APP_TIMEZONE=Asia/Manila
APP_KEY=replace-with-a-long-random-production-secret
BACKUP_ENCRYPTION_KEY=replace-with-a-different-long-random-secret
SESSION_SECURE_COOKIE=true
# Keep provider-rate enforcement in CLINiQ so a cohort remains pending safely.
MAIL_CAPACITY_INITIAL=300
MAIL_CAPACITY_MAX=300
MAIL_CAPACITY_GROWTH=0
# Generate a unique value before configuring the Brevo transactional webhook.
BREVO_WEBHOOK_SECRET=

AUTH_DB_NAME=Cliniq_db
DB_HOST=database
DB_PORT=3306
DB_USER=cliniq
DB_PASS=replace-with-a-strong-database-password

MARIADB_DATABASE=Cliniq_db
MARIADB_USER=cliniq
MARIADB_PASSWORD=replace-with-the-same-strong-database-password
MARIADB_ROOT_PASSWORD=replace-with-a-different-strong-root-password

BACKUP_ROOT=/var/backups/cliniq
BACKUP_EXTERNAL_ROOT=/var/backups/external
# Compose reads this value from the project-root .env, not this file. Leave the
# local placeholder in place until a BitLocker-encrypted drive is prepared.
BACKUP_EXTERNAL_HOST_PATH=./external-backups
MYSQL_BIN=/usr/bin/mariadb
MYSQL_PATH=/usr/bin/mariadb
MYSQLDUMP_PATH=/usr/bin/mariadb-dump
